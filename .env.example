# 复制本文件为 .env 后填入真实值：
#   copy .env.example .env
# .env 已被 git 忽略，不要提交到 GitHub。

# ---------- 数据库 ----------
# 将 USER / PASSWORD 换成你本机 PostgreSQL 账号
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/yanjiangnan_ai

# ---------- 阿里云百炼（通义千问） ----------
# 在 https://bailian.console.aliyun.com/ 创建 API Key，不要把真实 Key 写进本文件
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
VL_MODEL=qwen3-vl-flash
VL_OCR_MODEL=qwen-vl-ocr
VL_FALLBACK_MODEL=qwen3-vl-plus
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024
LLM_DEFAULT_TEMPERATURE=0.1

# true 时不调用真实大模型，使用预设演示结果
DEMO_MODE=false

# ---------- 登录鉴权 ----------
# JWT_SECRET 请换成足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
